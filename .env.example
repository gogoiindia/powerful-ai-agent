# LLM Configuration
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MODEL=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=4096

# GitHub Integration
GITHUB_TOKEN=ghp_...
GITHUB_USER=your_username
GITHUB_API_ENDPOINT=https://api.github.com

# Agent Configuration
AGENT_NAME=PowerfulAIAgent
AGENT_DESCRIPTION=A sophisticated multi-tool AI agent
MAX_ITERATIONS=10
TIMEOUT=300
VERBOSE=true
DEBUG=false

# Database
DATABASE_URL=sqlite:///./agent.db
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Web Search
SEARCH_API_KEY=your_key
SEARCH_ENGINE_ID=your_engine_id

# Execution
SANDBOX_ENABLED=true
MAX_EXECUTION_TIME=60
ALLOW_EXTERNAL_CALLS=true
